{
  "name": "dayploy/entity-does-not-exists-validation-constraint",
  "description": "Verify that your entity does not exists",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.1",
    "doctrine/orm": "^2.4 || ^3.0",
    "symfony/validator": "^6.0 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "symfony/phpunit-bridge": "^6.0",
    "symfony/validator": "^6.0 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Dayploy\\Validator\\Constraint\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Dayploy\\Validator\\Constraint\\": "tests/"
    }
  }
}
